{
  "swagger": "2.0",
  "info": {
    "title": "console/v1/auth.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "ConsoleAuthService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/console/auth/refresh": {
      "post": {
        "operationId": "ConsoleAuthService_RefreshToken",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignInResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1RefreshTokenRequest"
            }
          }
        ],
        "tags": [
          "ConsoleAuthService"
        ]
      }
    },
    "/v1/console/auth/setup-status": {
      "get": {
        "summary": "查询是否已完成初始化（admins 是否为空）。",
        "operationId": "ConsoleAuthService_GetSetupStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetSetupStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "ConsoleAuthService"
        ]
      }
    },
    "/v1/console/auth/sign-in": {
      "post": {
        "operationId": "ConsoleAuthService_SignIn",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignInResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignInRequest"
            }
          }
        ],
        "tags": [
          "ConsoleAuthService"
        ]
      }
    },
    "/v1/console/auth/sign-out": {
      "post": {
        "operationId": "ConsoleAuthService_SignOut",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Empty"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignOutRequest"
            }
          }
        ],
        "tags": [
          "ConsoleAuthService"
        ]
      }
    },
    "/v1/console/auth/sign-up": {
      "post": {
        "summary": "首个管理员注册：仅当 admins 表为空且携带正确 setup token 时可用；\n须同时指定 project_id 与 database_id，创建 owner + 项目 + 数据库。\n不生成 API Key，登录后在 Console 的 API Key 页面创建。",
        "operationId": "ConsoleAuthService_SignUp",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignUpResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/torchwoodconsolev1SignUpRequest"
            }
          }
        ],
        "tags": [
          "ConsoleAuthService"
        ]
      }
    }
  },
  "definitions": {
    "torchwoodconsolev1RefreshTokenRequest": {
      "type": "object",
      "properties": {
        "refresh_token": {
          "type": "string"
        }
      }
    },
    "torchwoodconsolev1SignInRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "torchwoodconsolev1SignInResponse": {
      "type": "object",
      "properties": {
        "access_token": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "refresh_token": {
          "type": "string"
        }
      }
    },
    "torchwoodconsolev1SignOutRequest": {
      "type": "object"
    },
    "torchwoodconsolev1SignUpRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "setup_token": {
          "type": "string",
          "title": "Console 引导令牌（security.setup_token / TORCHWOOD_SECURITY_SETUP_TOKEN）。"
        },
        "project_id": {
          "type": "string",
          "title": "首个项目 ID，须匹配 ^[a-z][a-z0-9]{0,27}$。"
        },
        "database_id": {
          "type": "string",
          "title": "首个业务数据库 ID，规则同 project_id。CreateProject 把它作为第一业务库\n创建（缺省 default）；系统集合在项目数据面 tw_\u003cproject\u003e，不在该库。"
        }
      }
    },
    "torchwoodconsolev1SignUpResponse": {
      "type": "object",
      "properties": {
        "admin": {
          "$ref": "#/definitions/v1Admin",
          "title": "复用 admins.proto 的 Admin 消息"
        },
        "access_token": {
          "type": "string",
          "title": "与 SignInResponse 一致，便于前端统一处理"
        },
        "refresh_token": {
          "type": "string"
        }
      }
    },
    "v1Admin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1Empty": {
      "type": "object"
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\n见 internal/infra/server/errors.go）：\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1GetSetupStatusResponse": {
      "type": "object",
      "properties": {
        "needs_setup": {
          "type": "boolean"
        },
        "setup_token_required": {
          "type": "boolean",
          "title": "部署方是否配置了 TORCHWOOD_SECURITY_SETUP_TOKEN；为 true 时登录页\n需展示 setup token 输入框。"
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "格式: Bearer \u003cjwt\u003e",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "项目绑定在密钥行上，不需要 X-Torchwood-Project。该头仅 Console admin 会话切换项目。",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e（Console admin 会话）",
      "name": "Cookie",
      "in": "header"
    }
  },
  "x-torchwood-access": "public"
}
