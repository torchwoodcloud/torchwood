{
  "swagger": "2.0",
  "info": {
    "title": "console/v1/admins.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AdminsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/console/admins": {
      "get": {
        "operationId": "AdminsService_ListAdmins",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAdminsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AdminsService"
        ]
      },
      "post": {
        "operationId": "AdminsService_CreateAdmin",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Admin"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateAdminRequest"
            }
          }
        ],
        "tags": [
          "AdminsService"
        ]
      }
    },
    "/v1/console/admins/me": {
      "get": {
        "operationId": "AdminsService_GetCurrentAdmin",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Admin"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "AdminsService"
        ]
      },
      "patch": {
        "summary": "UpdateCurrentAdmin 当前登录管理员自助更新个人偏好（非 role/password 等\n敏感字段；管理他人走 UpdateAdmin）。仅暴露 typed 偏好字段，存储侧落在\nadmins.metadata JSONB（见 Admin.timezone 注释）。\n声明位置必须在 UpdateAdmin 之后：PATCH /me 与 PATCH /{id} 同形竞争，\ngateway LIFO 匹配下后声明者胜（见上方路由顺序约束注释）。",
        "operationId": "AdminsService_UpdateCurrentAdmin",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Admin"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1UpdateCurrentAdminRequest"
            }
          }
        ],
        "tags": [
          "AdminsService"
        ]
      }
    },
    "/v1/console/admins/{id}": {
      "delete": {
        "operationId": "AdminsService_DeleteAdmin",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Empty"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AdminsService"
        ]
      },
      "patch": {
        "summary": "路由顺序约束（重要）：grpc-gateway 的 ServeMux.Handle 是头插（LIFO）——\n同 HTTP 方法下\"后注册的 pattern 先匹配\"，注册顺序 = proto 声明顺序。\n字面量路径 /me 与变量路径 /{id} 同形竞争时，字面量 rpc 必须声明在后，\n否则 /me 被 {id} 吞掉（UpdateAdmin(id=\"me\") 查库 nil → 404 admin not\nfound，回归测试见 cmd/server/internal/runtime/gateway_route_order_test.go）。",
        "operationId": "AdminsService_UpdateAdmin",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Admin"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AdminsServiceUpdateAdminBody"
            }
          }
        ],
        "tags": [
          "AdminsService"
        ]
      }
    }
  },
  "definitions": {
    "AdminsServiceUpdateAdminBody": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "title": "optional：未设置（或空串）= 不修改；设置合法角色值 = 更新（R10-P1-6）。"
        },
        "password": {
          "type": "string",
          "title": "非空则重置密码"
        }
      }
    },
    "v1Admin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "title": "用户偏好时区（IANA 名，自 admins.metadata.timezone 投影；空 = 未设置，\n前端回退浏览器时区）。metadata 本身不出 proto，新增偏好键在此追加\ntyped 字段。"
        }
      }
    },
    "v1CreateAdminRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "v1Empty": {
      "type": "object"
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\n见 internal/infra/server/errors.go）：\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1ListAdminsResponse": {
      "type": "object",
      "properties": {
        "admins": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Admin"
          }
        },
        "meta": {
          "$ref": "#/definitions/v1ListResponseMeta"
        }
      }
    },
    "v1ListResponseMeta": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "next_page_token": {
          "type": "string"
        },
        "prev_page_token": {
          "type": "string"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "title": "total_count ≤0 = unknown（keyset 分页下 0 与空集合不可区分，调用方应以 next_page_token 是否为空判定是否还有更多；≤0 表示总数未知）。"
        }
      }
    },
    "v1UpdateCurrentAdminRequest": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "title": "optional：未设置 = 不修改；设置空串 = 清除偏好（跟随浏览器时区）；\n设置非空 = 更新为该 IANA 时区名（如 Asia/Shanghai）。形状在此校验\n（pattern 放行空串——空串是\"清除\"语义，非空形状由分支约束），\nIANA 有效性由 use-case 层 time.LoadLocation 权威判定。"
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "格式: Bearer \u003cjwt\u003e",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "项目绑定在密钥行上，不需要 X-Torchwood-Project。该头仅 Console admin 会话切换项目。",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e（Console admin 会话）",
      "name": "Cookie",
      "in": "header"
    }
  },
  "security": [
    {
      "cookie": []
    }
  ],
  "x-torchwood-access": "permission"
}
