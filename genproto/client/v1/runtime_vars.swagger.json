  "paths": {
    "/v1/runtime-vars/{var_set_id}": {
      "get": {
        "summary": "GetRuntimeVars 拉取集合的全量快照。project_id 是匿名唯一可靠寻址\n（resolveProjectID 链第一级）；etag 透传上次响应值，命中则 unchanged=true\n且 vars 为空（不透明 token \"{epoch}:{revision}\"，D2）。SDK 轮询建议\nTTL ≥ 60s；收到 404 保留 last-known-good 缓存（D15）。",
        "operationId": "RuntimeVarsService_GetRuntimeVars",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetRuntimeVarsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "var_set_id",
            "description": "路径参数：集合名（创建后不可改，D9）。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "description": "匿名唯一可靠寻址；缺省回落 X-Torchwood-Project 头 → Principal（handler\n三级回落链，与 ListDocuments 同）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "etag",
            "description": "可选：上次响应的 etag；命中则短路返回 unchanged=true（vars 为空）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "RuntimeVarsService"
        ],
        "security": [],
        "x-torchwood-access": "public"
      }
    }
  },
  "definitions": {
