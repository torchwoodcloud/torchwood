{
  "swagger": "2.0",
  "info": {
    "title": "client/v1/subscriptions.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "SubscriptionsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/subscriptions": {
      "post": {
        "operationId": "SubscriptionsService_Subscribe",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SubscribeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SubscribeRequest"
            }
          }
        ],
        "tags": [
          "SubscriptionsService"
        ]
      }
    },
    "/v1/subscriptions/me": {
      "get": {
        "operationId": "SubscriptionsService_GetMySubscription",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodclientv1Subscription"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "plan_code",
            "description": "可选：按计划 code 过滤；空则返回当前非终态（或最近一条）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "SubscriptionsService"
        ]
      }
    },
    "/v1/subscriptions/plans": {
      "get": {
        "operationId": "SubscriptionsService_ListPlans",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodclientv1ListPlansResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "SubscriptionsService"
        ]
      }
    },
    "/v1/subscriptions/{subscription_id}:cancel": {
      "post": {
        "operationId": "SubscriptionsService_Cancel",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodclientv1Subscription"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SubscriptionsServiceCancelBody"
            }
          }
        ],
        "tags": [
          "SubscriptionsService"
        ]
      }
    }
  },
  "definitions": {
    "SubscriptionsServiceCancelBody": {
      "type": "object"
    },
    "torchwoodclientv1BenefitEntitlement": {
      "type": "object",
      "properties": {
        "asset_code": {
          "type": "string"
        },
        "tier": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "torchwoodclientv1BenefitGrant": {
      "type": "object",
      "properties": {
        "asset_code": {
          "type": "string"
        },
        "quantity": {
          "type": "string",
          "format": "int64"
        },
        "expires_in": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "torchwoodclientv1Benefits": {
      "type": "object",
      "properties": {
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/torchwoodclientv1BenefitGrant"
          }
        },
        "entitlements": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/torchwoodclientv1BenefitEntitlement"
          }
        }
      }
    },
    "torchwoodclientv1ListPlansResponse": {
      "type": "object",
      "properties": {
        "plans": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/torchwoodclientv1SubscriptionPlan"
          }
        },
        "meta": {
          "$ref": "#/definitions/v1ListResponseMeta"
        }
      }
    },
    "torchwoodclientv1Subscription": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "plan_code": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "title": "hosted | platform"
        },
        "status": {
          "type": "string",
          "title": "trialing | active | past_due | canceled | expired"
        },
        "current_period_start": {
          "type": "string",
          "format": "date-time"
        },
        "current_period_end": {
          "type": "string",
          "format": "date-time"
        },
        "cancel_at_period_end": {
          "type": "boolean"
        },
        "grace_until": {
          "type": "string",
          "format": "date-time"
        },
        "benefits": {
          "$ref": "#/definitions/torchwoodclientv1Benefits"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payment_url": {
          "type": "string",
          "title": "渠道收银台 / 一次性支付 URL；仅 Subscribe 响应可能填充。"
        }
      }
    },
    "torchwoodclientv1SubscriptionPlan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "amount": {
          "type": "string",
          "format": "int64"
        },
        "currency": {
          "type": "string"
        },
        "interval": {
          "type": "string",
          "title": "month | year | custom_days"
        },
        "interval_days": {
          "type": "string",
          "format": "int64"
        },
        "grace_days": {
          "type": "integer",
          "format": "int32"
        },
        "trial_days": {
          "type": "integer",
          "format": "int32"
        },
        "benefits": {
          "$ref": "#/definitions/torchwoodclientv1Benefits"
        }
      }
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\n见 internal/infra/server/errors.go）：\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1ListResponseMeta": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "next_page_token": {
          "type": "string"
        },
        "prev_page_token": {
          "type": "string"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "title": "total_count ≤0 = unknown（keyset 分页下 0 与空集合不可区分，调用方应以 next_page_token 是否为空判定是否还有更多；≤0 表示总数未知）。"
        }
      }
    },
    "v1SubscribeRequest": {
      "type": "object",
      "properties": {
        "plan_code": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "title": "hosted | platform"
        },
        "idempotency_key": {
          "type": "string"
        },
        "billing_asset_code": {
          "type": "string",
          "title": "platform：Consume 该资产 def code（currency/stack）；空则生成支付订单。"
        }
      }
    },
    "v1SubscribeResponse": {
      "type": "object",
      "properties": {
        "subscription": {
          "$ref": "#/definitions/torchwoodclientv1Subscription"
        },
        "idempotent_replay": {
          "type": "boolean"
        },
        "payment_url": {
          "type": "string"
        },
        "order_id": {
          "type": "string"
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "格式: Bearer \u003cjwt\u003e（Client API 登录态）",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "项目绑定在密钥行上，不需要 X-Torchwood-Project。该头仅 Console admin 会话切换项目。",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e（Console admin 会话）",
      "name": "Cookie",
      "in": "header"
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "x-torchwood-access": "end_user"
}
