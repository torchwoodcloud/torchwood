{
  "swagger": "2.0",
  "info": {
    "title": "client/v1/payments.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "PaymentsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/payments/ios/verify-receipt": {
      "post": {
        "summary": "VerifyReceipt 校验 iOS IAP receipt / StoreKit 2 JWS 并履约对应订单\n（设计 §1.2：iOS 无服务端下单，走验票路径）。",
        "operationId": "PaymentsService_VerifyReceipt",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1VerifyReceiptResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1VerifyReceiptRequest"
            }
          }
        ],
        "tags": [
          "PaymentsService"
        ]
      }
    },
    "/v1/payments/orders": {
      "get": {
        "operationId": "PaymentsService_ListMyOrders",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListMyOrdersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "description": "不透明游标（上一页最后一条的创建时间）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "PaymentsService"
        ]
      },
      "post": {
        "operationId": "PaymentsService_CreateOrder",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateOrderResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateOrderRequest"
            }
          }
        ],
        "tags": [
          "PaymentsService"
        ]
      }
    },
    "/v1/payments/orders/{order_id}": {
      "get": {
        "operationId": "PaymentsService_GetMyOrder",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodclientv1PaymentOrder"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "PaymentsService"
        ]
      }
    }
  },
  "definitions": {
    "protobufNullValue": {
      "type": "string",
      "enum": [
        "NULL_VALUE"
      ],
      "default": "NULL_VALUE",
      "description": "`NullValue` is a singleton enumeration to represent the null value for the\n`Value` type union.\n\nThe JSON representation for `NullValue` is JSON `null`.\n\n - NULL_VALUE: Null value."
    },
    "torchwoodclientv1PaymentOrder": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "amount": {
          "type": "string",
          "format": "int64"
        },
        "currency": {
          "type": "string"
        },
        "purpose_kind": {
          "type": "string",
          "title": "topup | item_purchase | subscription"
        },
        "purpose": {
          "type": "object",
          "title": "用途载荷：{currency_code, amount} / {asset_code, quantity} / {plan_code}"
        },
        "status": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "paid_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "payment_url": {
          "type": "string",
          "title": "渠道收银台地址（Stripe Checkout URL 等）；仅 CreateOrder 响应填充，\n查询接口不返回。"
        }
      },
      "title": "PaymentOrder 是支付订单（v3 设计 §1.3）。amount 一律最小货币单位的\nint64（禁止 float）；status 状态机：\ncreated → paying → paid | failed | closed → refunding → refunded。"
    },
    "v1CreateOrderRequest": {
      "type": "object",
      "properties": {
        "idempotency_key": {
          "type": "string",
          "title": "客户端建单幂等键：同 (project, key) 重复建单返回原单（设计 §1.3）。"
        },
        "provider": {
          "type": "string",
          "title": "stripe | wechat | alipay | ios_iap。"
        },
        "amount": {
          "type": "string",
          "format": "int64",
          "title": "最小货币单位金额，必须 \u003e 0（如 1999 = 19.99 USD）。"
        },
        "currency": {
          "type": "string",
          "title": "ISO-4217 三字母码（usd / cny ...）。"
        },
        "purpose_kind": {
          "type": "string",
          "title": "topup | item_purchase（subscription 在 PR3 开放）。"
        },
        "purpose": {
          "type": "object"
        },
        "success_url": {
          "type": "string",
          "title": "Checkout 回跳地址（Stripe 一次性支付）；未传则用 server.http.public_url。"
        },
        "cancel_url": {
          "type": "string"
        }
      }
    },
    "v1CreateOrderResponse": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/definitions/torchwoodclientv1PaymentOrder"
        },
        "idempotent_replay": {
          "type": "boolean",
          "title": "true = 命中幂等键返回原单（未向渠道重复下单）。"
        }
      }
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\r\n见 internal/infra/server/errors.go）：\r\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\r\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\r\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\r\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\r\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\r\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\r\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\r\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\r\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\r\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1ListMyOrdersResponse": {
      "type": "object",
      "properties": {
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/torchwoodclientv1PaymentOrder"
          }
        },
        "meta": {
          "$ref": "#/definitions/v1ListResponseMeta"
        }
      }
    },
    "v1ListResponseMeta": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "next_page_token": {
          "type": "string"
        },
        "prev_page_token": {
          "type": "string"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "title": "total_count ≤0 = unknown（keyset 分页下 0 与空集合不可区分，调用方应以 next_page_token 是否为空判定是否还有更多；≤0 表示总数未知）。"
        }
      }
    },
    "v1VerifyReceiptRequest": {
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string"
        },
        "receipt": {
          "type": "string"
        }
      },
      "title": "VerifyReceiptRequest 是 iOS 验票请求：receipt 为 StoreKit base64 PKCS7\n或 StoreKit 2 signed transaction JWS；order_id 指向本人 ios_iap 订单。"
    },
    "v1VerifyReceiptResponse": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/definitions/torchwoodclientv1PaymentOrder"
        },
        "transaction_id": {
          "type": "string"
        },
        "idempotent_replay": {
          "type": "boolean",
          "title": "true = 同 transactionId 重放（已履约，不重复发货）。"
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "格式: Bearer \u003cjwt\u003e（Client API 登录态）",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "项目绑定在密钥行上，不需要 X-Torchwood-Project。该头仅 Console admin 会话切换项目。",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e（Console admin 会话）",
      "name": "Cookie",
      "in": "header"
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "x-torchwood-access": "end_user"
}
