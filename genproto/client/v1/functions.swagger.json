{
  "swagger": "2.0",
  "info": {
    "title": "client/v1/functions.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "FunctionsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/functions/{function_id}:invoke": {
      "post": {
        "summary": "InvokeFunction 同步调用一个 client_callable 函数。",
        "description": "错误形态：\n  - PERMISSION_DENIED：函数未开启 client_callable（存量默认，fail-closed）；\n  - RESOURCE_EXHAUSTED：每用户限频超限（ErrorInfo.Reason =\n    FUNCTIONS.INVOKE_QUOTA_EXCEEDED + RetryInfo 指向窗口结束时刻）或\n    每用户并发闸门排队超时——两者都不是响应字段；\n  - FAILED_PRECONDITION：函数已禁用。",
        "operationId": "FunctionsService_InvokeFunction",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1InvokeFunctionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "function_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/FunctionsServiceInvokeFunctionBody"
            }
          }
        ],
        "tags": [
          "FunctionsService"
        ]
      }
    }
  },
  "definitions": {
    "FunctionsServiceInvokeFunctionBody": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "title": "函数入参：JSON object 字符串（≤32KB，服务端校验形状与字节上限）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "可选：指定 deployment（必须 ready）；缺省用最新 ready。"
        },
        "idempotency_key": {
          "type": "string",
          "title": "可选客户端幂等键：网络超时重试防重复执行。(project, function, user, key)\n唯一去重，命中返回既有 execution 原样（进行中返回 running）。"
        }
      }
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\n见 internal/infra/server/errors.go）：\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1InvokeFunctionResponse": {
      "type": "object",
      "properties": {
        "execution_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "completed | failed | running（幂等命中且执行仍在进行时）。"
        },
        "response": {
          "type": "string",
          "title": "函数响应：stdout 末行 JSON（无合法 JSON 时为空）。"
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "格式: Bearer \u003cjwt\u003e（Client API 登录态）",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "项目绑定在密钥行上，不需要 X-Torchwood-Project。该头仅 Console admin 会话切换项目。",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e（Console admin 会话）",
      "name": "Cookie",
      "in": "header"
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "x-torchwood-access": "end_user"
}
