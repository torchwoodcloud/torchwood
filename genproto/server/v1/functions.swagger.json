  "definitions": {
    "FunctionsServiceCreateFunctionTriggerBody": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "title": "触发器类型：http | cron | event（大小写敏感）。"
        },
        "http": {
          "$ref": "#/definitions/v1HttpTriggerConfig",
          "title": "type=http 时必填。"
        },
        "cron": {
          "$ref": "#/definitions/v1CronTriggerConfig",
          "title": "type=cron 时必填。"
        },
        "event": {
          "$ref": "#/definitions/v1EventTriggerConfig",
          "title": "type=event 时必填（v3 切片 D，functions-v3.md §4.1）。"
        }
      },
      "title": "CreateFunctionTriggerRequest 创建触发器：type 选择 http / cron / event，\n三选一填 http / cron / event 配置段。token 服务端生成，不收入参。"
    },
    "FunctionsServiceRotateFunctionSecretBody": {
      "type": "object",
      "title": "RotateFunctionSecretRequest 轮换 endpoint target 签名密钥。"
    },
    "FunctionsServiceRotateFunctionTriggerTokenBody": {
      "type": "object"
    },
    "FunctionsServiceSetFunctionScopesBody": {
      "type": "object",
      "properties": {
        "declared_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "title": "SetFunctionScopesRequest 全量替换函数 declared_scopes（P0 执行身份；\n空集 = 撤销全部平台访问）。"
    },
    "FunctionsServiceUpdateFunctionBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "int32"
        },
        "enabled": {
          "type": "boolean"
        },
        "client_callable": {
          "type": "boolean",
          "title": "——客户端调用面策略（P2，设计 §4；未设置 = 不修改）——"
        },
        "client_anonymous_allowed": {
          "type": "boolean",
          "title": "字段保留、一期禁用：置 true 显式报错「一期未开放」。"
        },
        "client_per_user_limit": {
          "type": "integer",
          "format": "int32"
        },
        "client_limit_window": {
          "type": "string"
        },
        "target_url": {
          "type": "string",
          "title": "endpoint target url（v4 §3）：未设置 = 不修改；密钥变更走\nRotateFunctionSecret（与 webhooks Update/Rotate 分工一致）。"
        }
      }
    },
    "torchwoodserverv1FunctionsServiceInvokeFunctionBody": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string"
        },
        "async": {
          "type": "boolean"
        }
      },
      "title": "InvokeFunctionRequest 调用一个函数（v4 §2：CreateExecutionRequest 改名；\ndeployment_id 已随部署面退役——目标恒为函数当前的 endpoint target）。"
    },
    "v1CreateFunctionRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "客户端自选 function_id；functions:invoke / functions:rotate-secret\n为自定义方法段（REST 自定义动词），不占用 function_id 命名空间，\n可自由取任意合法值。"
        },
        "name": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "int32"
        },
        "enabled": {
          "type": "boolean"
        },
        "declared_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "执行身份声明（P0）：词表校验/去重在服务端（app 层），空集合法。"
        },
        "client_callable": {
          "type": "boolean",
          "title": "——客户端调用面策略（P2，设计 §4）——"
        },
        "client_anonymous_allowed": {
          "type": "boolean",
          "title": "字段保留、一期禁用：置 true 显式报错「一期未开放」。"
        },
        "client_per_user_limit": {
          "type": "integer",
          "format": "int32",
          "title": "client_callable=true 时必须 \u003e= 1。"
        },
        "client_limit_window": {
          "type": "string"
        },
        "target_url": {
          "type": "string",
          "title": "endpoint target url（v4 §3）：函数常驻服务的调用终点。生产强制 https\n（开发环境可放行 http，校验在服务端 app 层按环境裁决）。"
        },
        "target_secret": {
          "type": "string",
          "title": "可选自定义签名密钥（twfnsec_ 前缀；空 = 服务端生成）。两种来源都只在\n本请求出现一次，落库前加密。"
        }
      }
    },
    "v1CreateFunctionResponse": {
      "type": "object",
      "properties": {
        "function": {
          "$ref": "#/definitions/v1Function"
        },
        "target_secret": {
          "type": "string",
          "title": "target 签名密钥明文（服务端生成或透传录入值）。之后只出指纹。"
        }
      },
      "title": "CreateFunctionResponse 是创建响应：函数视图 + 一次性 target 签名密钥明文\n（仅此一次；之后任何面只出指纹）。"
    },
    "v1CronTriggerConfig": {
      "type": "object",
      "properties": {
        "expr": {
          "type": "string",
          "title": "5 字段 cron 表达式（分 时 日 月 周，UTC；支持 * , - / 数字；周 0-7 且\n7=0）。解析校验在服务端（领域层 cronexpr）。"
        },
        "misfire": {
          "type": "string",
          "title": "错过策略：skip（只推进不补跑）| catch_up_once（补跑一次；默认）。"
        }
      },
      "title": "CronTriggerConfig 是 cron 触发器配置（K10：一期 UTC）。"
    },
    "v1Empty": {
      "type": "object"
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\n见 internal/infra/server/errors.go）：\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1EventTriggerConfig": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "订阅串列表（1..64 条，单条 ≤200 字节；服务端逐条格式校验）。"
        }
      },
      "title": "EventTriggerConfig 是事件触发器配置（v3 切片 D，functions-v3.md §4.1/D12\n+ §4.1 增补）。订阅串双形态：\n  文档写事件（业界同构）：\n    databases.{database_id}.collections.{collection_id}.documents.{op}\n  op ∈ {create, update, delete, *}；collection 段可为 `*`；database 段一期\n  必须精确（database 级通配后置）。\n  系统行为事件（§4.1 增补）：\n    {domain}.* | {domain}.{resource}.* | {domain}.{resource}.{op}（精确全名）\n  域词表 = 平台系统事件目录（auth / payments / economy / subscriptions，\n  唯一声明源 internal/domain/events/catalog.go，如 auth.users.created、\n  payments.orders.paid）；`*` 仅允许尾段；目录内无命中的前缀直接拒绝\n  （fail-closed，拼错立刻 400）。格式校验在服务端（领域层 eventmatch）。\n自环警告（D13）：订阅本函数自身写入的集合会形成「写→事件→再触发」循环，\n平台一期不做硬防护，Console 编辑处文案警告。"
    },
    "v1Function": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "int32"
        },
        "enabled": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "declared_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "函数执行 principal 的平台访问声明（P0 执行身份）：每项形如\n\"\u003cresource\u003e:\u003cop\u003e\"（如 \"assets:write\"），词表见\ndocs/developer/08-functions.md「执行身份」；空集 = 无平台访问权限\n（fail-closed 默认）。管理经 SetFunctionScopes 全量替换。"
        },
        "client_callable": {
          "type": "boolean",
          "title": "——客户端调用面策略（P2，设计 §4）——"
        },
        "client_anonymous_allowed": {
          "type": "boolean",
          "title": "字段保留、一期禁用：置 true 会被服务端显式拒绝（Q4 拍板：匿名 IP 兜底\n限频做好后再开）。"
        },
        "client_per_user_limit": {
          "type": "integer",
          "format": "int32",
          "title": "每用户限频配额（client_limit_window 窗口内）；client_callable=true\n要求 \u003e= 1。"
        },
        "client_limit_window": {
          "type": "string",
          "title": "限频窗口：minute | hour | day（day 按 UTC 日期）。"
        },
        "target": {
          "$ref": "#/definitions/v1FunctionTarget",
          "title": "endpoint target（v4 §3 单一 endpoint kind；proto 留 fleetly kind 扩展位\n——仅当需要原生 warm invoke/指标透出时立项，v4 不实现）。"
        }
      },
      "title": "Function 是函数视图。v4 target 模型（§3）：执行位置 = endpoint 常驻服务；\n池策略/运行时/资源规格归 substrate（fleetly 副本数 / k8s HPA / 用户自管），\n字段号与名称 retired（见 reserved）。"
    },
    "v1FunctionSecret": {
      "type": "object",
      "properties": {
        "function_id": {
          "type": "string"
        },
        "secret": {
          "type": "string",
          "title": "签名密钥明文（twfnsec_ 前缀 + 32 字节 base64url）。之后只出指纹。"
        },
        "secret_fingerprint": {
          "type": "string",
          "title": "轮换后的指纹（便于与既有记录核对）。"
        }
      },
      "title": "FunctionSecret 是轮换响应：明文只出现这一次，调用方立即部署到函数侧。"
    },
    "v1FunctionTarget": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "title": "函数常驻服务的调用终点（生产强制 https；开发环境经 app 层放行 http）。"
        },
        "secret_fingerprint": {
          "type": "string",
          "title": "签名密钥指纹（\"twfnsec_\" + SHA-256 前 8 hex；比对用，非明文）。"
        },
        "secret_rotated_at": {
          "type": "string",
          "format": "date-time",
          "title": "最近一次密钥轮换时刻（宽限窗内旧钥 v2 双签）。"
        }
      },
      "title": "FunctionTarget 是函数的执行终点（v4 §3 单一 endpoint target 模型）。\n密钥任何形态不回显：明文仅在创建/轮换响应一次性返回（实施勘误 2026-10-15：\n签名方每次调用需明文计算 HMAC——密钥本体 secretbox 加密落库，API 面只出\n指纹），管理面只出 secret_fingerprint。"
    },
    "v1FunctionTrigger": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "function_id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "response_mode": {
          "type": "string",
          "title": "——http——"
        },
        "ack_body": {
          "type": "string"
        },
        "handshake": {
          "type": "string"
        },
        "body_limit_bytes": {
          "type": "integer",
          "format": "int32"
        },
        "token": {
          "type": "string"
        },
        "invoke_path": {
          "type": "string",
          "title": "公开调用路径 /f/{project_id}/{token}（host 侧自行拼接）。"
        },
        "expr": {
          "type": "string",
          "title": "——cron——"
        },
        "misfire": {
          "type": "string"
        },
        "next_run_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "——event——订阅串列表（type=event 时非空）。"
        }
      },
      "title": "FunctionTrigger 是触发器视图。http 专有字段（token/invoke_path/response_mode/\nack_body/handshake/body_limit_bytes）与 cron 专有字段（expr/misfire/\nnext_run_at）按 type 取用；token 明文仅在管理面返回。"
    },
    "v1HttpTriggerConfig": {
      "type": "object",
      "properties": {
        "response_mode": {
          "type": "string",
          "title": "双响应模式（二轮复审：微信 SSV 回调 1s 超时，纯同步大概率超时丢事件）：\n  sync      同步执行（≤30s）并透传函数响应；\n  async_ack 立即 200 + ack_body，函数走异步队列（200 是「已受理」语义）。"
        },
        "ack_body": {
          "type": "string",
          "title": "async_ack 模式下的 200 响应体（≤1KB，防带宽放大）；sync 模式忽略。"
        },
        "handshake": {
          "type": "string",
          "title": "GET 握手：echo = 平台直接回 {\"echostr\": \u003cquery.echostr\u003e}，不 invoke。\n空 = GET 一律 405。"
        },
        "body_limit_bytes": {
          "type": "integer",
          "format": "int32",
          "title": "请求体上限（字节）：缺省 65536（64KB），上限 1048576（1MB）。"
        }
      },
      "title": "HttpTriggerConfig 是 HTTP 触发器配置。"
    },
    "v1Invocation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "function_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "queued | running | completed | failed（v4 收敛：building 态随补构建退役）。"
        },
        "response": {
          "type": "string"
        },
        "status_code": {
          "type": "integer",
          "format": "int32"
        },
        "duration_ms": {
          "type": "string",
          "format": "int64"
        },
        "error": {
          "type": "string"
        },
        "response_truncated": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "Invocation 是一次函数调用记录（v4 §2：Execution 改名——torchwood 只发起\n调用、不执行）。stdout/stderr 已退役：日志归 substrate 侧（fleetly logs /\n用户服务自管），torchwood 只见网关往返结果。"
    },
