  "definitions": {
    "FunctionsServiceCreateDeploymentBody": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "format": "byte"
        }
      },
      "title": "code 为 zip 代码包，≤1MiB 走此通道；更大的包走 multipart 上传\n（POST /v1/server/functions/{function_id}/deployments/code）。"
    },
    "FunctionsServiceCreateExecutionBody": {
      "type": "object",
      "properties": {
        "deployment_id": {
          "type": "string",
          "title": "缺省用最新 ready deployment"
        },
        "data": {
          "type": "string"
        },
        "async": {
          "type": "boolean"
        }
      }
    },
    "FunctionsServiceCreateFunctionTriggerBody": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "title": "触发器类型：http | cron（大小写敏感）。"
        },
        "http": {
          "$ref": "#/definitions/v1HttpTriggerConfig",
          "title": "type=http 时必填。"
        },
        "cron": {
          "$ref": "#/definitions/v1CronTriggerConfig",
          "title": "type=cron 时必填。"
        }
      },
      "title": "CreateFunctionTriggerRequest 创建触发器：type 选择 http / cron，二选一\n填 http / cron 配置段。token 服务端生成，不收入参。"
    },
    "FunctionsServiceRotateFunctionTriggerTokenBody": {
      "type": "object"
    },
    "FunctionsServiceSetFunctionScopesBody": {
      "type": "object",
      "properties": {
        "declared_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "title": "SetFunctionScopesRequest 全量替换函数 declared_scopes（P0 执行身份；\n空集 = 撤销全部平台访问）。"
    },
    "FunctionsServiceSetVariablesBody": {
      "type": "object",
      "properties": {
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Variable"
          }
        }
      },
      "title": "SetVariablesRequest 全量替换函数环境变量。"
    },
    "FunctionsServiceUpdateFunctionBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "int32"
        },
        "spec": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "client_callable": {
          "type": "boolean",
          "title": "——客户端调用面策略（P2，设计 §4；未设置 = 不修改）——"
        },
        "client_anonymous_allowed": {
          "type": "boolean",
          "title": "字段保留、一期禁用：置 true 显式报错「一期未开放」。"
        },
        "client_per_user_limit": {
          "type": "integer",
          "format": "int32"
        },
        "client_limit_window": {
          "type": "string"
        }
      }
    },
    "v1CreateFunctionRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "客户端自选 function_id；functions:runtimes / functions:specifications\n为自定义方法段（REST 自定义动词），不再占用 function_id 命名空间，\n可自由取任意合法值。"
        },
        "name": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "int32"
        },
        "spec": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "declared_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "执行身份声明（P0）：词表校验/去重在服务端（app 层），空集合法。"
        },
        "client_callable": {
          "type": "boolean",
          "title": "——客户端调用面策略（P2，设计 §4）——"
        },
        "client_anonymous_allowed": {
          "type": "boolean",
          "title": "字段保留、一期禁用：置 true 显式报错「一期未开放」。"
        },
        "client_per_user_limit": {
          "type": "integer",
          "format": "int32",
          "title": "client_callable=true 时必须 \u003e= 1。"
        },
        "client_limit_window": {
          "type": "string"
        }
      }
    },
    "v1CronTriggerConfig": {
      "type": "object",
      "properties": {
        "expr": {
          "type": "string",
          "title": "5 字段 cron 表达式（分 时 日 月 周，UTC；支持 * , - / 数字；周 0-7 且\n7=0）。解析校验在服务端（领域层 cronexpr）。"
        },
        "misfire": {
          "type": "string",
          "title": "错过策略：skip（只推进不补跑）| catch_up_once（补跑一次；默认）。"
        }
      },
      "title": "CronTriggerConfig 是 cron 触发器配置（K10：一期 UTC）。"
    },
    "v1Deployment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
