{
  "swagger": "2.0",
  "info": {
    "title": "server/v1/oauth_providers.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "OAuthProvidersService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/server/oauth-providers": {
      "get": {
        "operationId": "OAuthProvidersService_ListOAuthProviders",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListOAuthProvidersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "queries",
            "description": "queries 是静态表面遗留的 DSL 串通道，与文档查询栈的单\ntyped AST（shared.v1.Query）相互独立。消费面：users ListUsers 经\nParseUserList 白名单解析（equal/greaterThan/lessThan + 白名单属性）；\nstorage buckets/files 与 groups（ListGroups/ListMemberships）不支持——\n携带即 InvalidArgument（显式拒绝，不静默忽略）；其余使用本消息的面以\n各自 handler 的显式行为为准。",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "sort_order",
            "description": "时间列排序方向；支持面以各 handler 的显式行为为准（Console 列表页\n按 created_at 正/倒序），UNSPECIFIED = 历史默认 DESC。",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "SORT_ORDER_UNSPECIFIED",
              "SORT_ORDER_ASC",
              "SORT_ORDER_DESC"
            ],
            "default": "SORT_ORDER_UNSPECIFIED"
          }
        ],
        "tags": [
          "OAuthProvidersService"
        ]
      }
    },
    "/v1/server/oauth-providers/{provider}": {
      "delete": {
        "operationId": "OAuthProvidersService_DeleteOAuthProvider",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Empty"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "OAuthProvidersService"
        ]
      },
      "put": {
        "operationId": "OAuthProvidersService_UpsertOAuthProvider",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1OAuthProvider"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OAuthProvidersServiceUpsertOAuthProviderBody"
            }
          }
        ],
        "tags": [
          "OAuthProvidersService"
        ]
      }
    }
  },
  "definitions": {
    "OAuthProvidersServiceUpsertOAuthProviderBody": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string",
          "title": "OAuth client secret：仅写入（Upsert）时接受；响应不回显（OAuthProvider\n仅返回 has_client_secret 布尔）。optional：未设置 = 保持现有 secret 不变；\n设置为非空串 = 轮换为新值；空串 = 不允许清空（服务端按\"保持不变\"处理）。"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "v1Empty": {
      "type": "object"
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\n见 internal/infra/server/errors.go）：\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1ListOAuthProvidersResponse": {
      "type": "object",
      "properties": {
        "oauth_providers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1OAuthProvider"
          }
        },
        "meta": {
          "$ref": "#/definitions/v1ListResponseMeta"
        }
      }
    },
    "v1ListResponseMeta": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "next_page_token": {
          "type": "string"
        },
        "prev_page_token": {
          "type": "string"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "title": "total_count ≤0 = unknown（keyset 分页下 0 与空集合不可区分，调用方应以 next_page_token 是否为空判定是否还有更多；≤0 表示总数未知）。"
        }
      }
    },
    "v1OAuthProvider": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "client_id": {
          "type": "string"
        },
        "has_client_secret": {
          "type": "boolean"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1SortOrder": {
      "type": "string",
      "enum": [
        "SORT_ORDER_UNSPECIFIED",
        "SORT_ORDER_ASC",
        "SORT_ORDER_DESC"
      ],
      "default": "SORT_ORDER_UNSPECIFIED",
      "title": "SortOrder 是时间列排序方向（Console 列表页「按创建时间正/倒序」）。\n固定排序键 = 各端点的时间列（通常 created_at），不是 AIP-160 任意列\norder_by（W-K 终结裁决维持：filter/order_by 不复活）。UNSPECIFIED =\n各端点历史默认（created_at DESC，最新在前）。keyset 游标与方向耦合，\n换向必须从第一页重新开始，携带异向游标即 InvalidArgument。"
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "Format: Bearer \u003cjwt\u003e",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "The project is bound to the API key row; X-Torchwood-Project is not needed. This header is only for Console admin sessions switching projects.",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e (Console admin session)",
      "name": "Cookie",
      "in": "header"
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "x-torchwood-access": "server"
}
