  "paths": {
    "/v1/server/billing/rollups": {
      "get": {
        "operationId": "BillingService_ListRollups",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListRollupsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "metric",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "period_start",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "period_end",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          }
        ],
        "tags": [
          "BillingService"
        ]
      }
    },
    "/v1/server/billing/statements": {
      "get": {
        "operationId": "BillingService_ListStatements",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListStatementsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "queries",
            "description": "queries 是静态表面遗留的 Appwrite 风格 DSL 串通道，与文档查询栈的单\ntyped AST（shared.v1.Query）相互独立。消费面：users ListUsers 经\nParseUserList 白名单解析（equal/greaterThan/lessThan + 白名单属性）；\nstorage buckets/files 与 groups（ListGroups/ListMemberships）不支持——\n携带即 InvalidArgument（显式拒绝，不静默忽略）；其余使用本消息的面以\n各自 handler 的显式行为为准。",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          }
        ],
        "tags": [
          "BillingService"
        ]
      }
    },
    "/v1/server/billing/usage": {
      "get": {
        "operationId": "BillingService_GetUsage",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Usage"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "metric",
            "description": "空=全部计量点（api_calls / storage_bytes / function_duration_ms）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "period_start",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "period_end",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          }
        ],
        "tags": [
          "BillingService"
        ]
      }
    }
  },
  "definitions": {
    "protobufNullValue": {
      "type": "string",
      "enum": [
        "NULL_VALUE"
      ],
      "default": "NULL_VALUE",
      "description": "`NullValue` is a singleton enumeration to represent the null value for the\n`Value` type union.\n\nThe JSON representation for `NullValue` is JSON `null`.\n\n - NULL_VALUE: Null value."
    },
    "v1BillingStatement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "period_start": {
          "type": "string",
          "format": "date-time"
        },
        "period_end": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "title": "draft | final"
        },
        "details": {
          "type": "object"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "finalized_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "BillingStatement 是月账单文档（draft → final；JSONB 明细与 rollups 对账）。"
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\r\n见 internal/infra/server/errors.go）：\r\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\r\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\r\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\r\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\r\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\r\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\r\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\r\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\r\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\r\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1ListResponseMeta": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "next_page_token": {
          "type": "string"
        },
        "prev_page_token": {
          "type": "string"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "title": "total_count ≤0 = unknown（keyset 分页下 0 与空集合不可区分，调用方应以 next_page_token 是否为空判定是否还有更多；≤0 表示总数未知）。"
        }
      }
    },
    "v1ListRollupsResponse": {
      "type": "object",
      "properties": {
        "rollups": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1UsageRollup"
          }
        },
        "meta": {
          "$ref": "#/definitions/v1ListResponseMeta"
        }
      }
    },
    "v1ListStatementsResponse": {
      "type": "object",
      "properties": {
        "statements": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1BillingStatement"
          }
        },
        "meta": {
          "$ref": "#/definitions/v1ListResponseMeta"
        }
      }
    },
    "v1Usage": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "period_start": {
          "type": "string",
          "format": "date-time"
        },
        "period_end": {
          "type": "string",
          "format": "date-time"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1UsageMetric"
          }
        }
      },
      "title": "Usage 是项目在时间窗内各 metric 的合计（value 一律 int64 最小单位）。"
    },
    "v1UsageMetric": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1UsageRollup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "period_start": {
          "type": "string",
          "format": "date-time"
        },
        "value": {
          "type": "string",
          "format": "int64"
        }
      },
      "title": "UsageRollup 是一小时 bucket 的落表行。"
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "格式: Bearer \u003cjwt\u003e",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "项目绑定在密钥行上，不需要 X-Torchwood-Project。该头仅 Console admin 会话切换项目。",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e（Console admin 会话）",
      "name": "Cookie",
      "in": "header"
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "x-torchwood-access": "server"
}
