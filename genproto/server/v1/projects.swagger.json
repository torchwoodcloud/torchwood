    "/v1/server/projects/{project_id}/invite-codes": {
      "get": {
        "operationId": "ProjectsService_ListInviteCodes",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListInviteCodesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "ProjectsService"
        ],
        "x-torchwood-access": "permission"
      },
      "post": {
        "summary": "---- 邀请码（T-03，invite_only 注册策略）----\n平台专属面（key 凭证禁入）：邀请码是注册凭证的逆向物，泄漏可绕过\n注册策略，故管理权仅 owner/admin console 会话。\n实际准入比声明的 permissions 通道更窄：以下三个 RPC 的 use-case 层\n额外要求 platform admin（internal/app/server RequirePlatformPrincipal，\nfail-closed 纵深防御）。proto 侧放开 owner/admin 角色访问通道 + app 层\n收窄属有意分层，声明保持不变；authorization matrix 由 method_auth 派生，\n只反映本声明，不反映 app 层收窄。",
        "operationId": "ProjectsService_CreateInviteCode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1InviteCode"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ProjectsServiceCreateInviteCodeBody"
            }
          }
        ],
        "tags": [
          "ProjectsService"
        ],
        "x-torchwood-access": "permission"
      }
    },
    "/v1/server/projects/{project_id}/invite-codes/{id}": {
      "delete": {
        "summary": "吊销邀请码（软删：revoked_at 置位，消费路径立即拒绝）。",
        "operationId": "ProjectsService_DeleteInviteCode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Empty"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ProjectsService"
        ],
        "x-torchwood-access": "permission"
      }
    },
    "/v1/server/projects/{project_id}/oauth-redirect-allowlist": {
      "put": {
        "summary": "---- OAuth 重定向白名单 ----\n平台专属面（key 凭证禁入）：白名单是 OAuth2 登录/魔法链接/恢复/验证等\n重定向流的可落点集合，篡改可用于钓鱼劫持端用户会话，管理权仅\nowner/admin console 会话。",
        "operationId": "ProjectsService_UpdateOAuthRedirectAllowlist",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Project"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ProjectsServiceUpdateOAuthRedirectAllowlistBody"
            }
          }
        ],
        "tags": [
          "ProjectsService"
        ],
        "x-torchwood-access": "permission"
      }
    }
  },
  "definitions": {
    "ProjectsServiceCreateInviteCodeBody": {
      "type": "object",
      "properties": {
        "max_uses": {
          "type": "integer",
          "format": "int32",
          "title": "最大使用次数；不设置 = 1（一次性）。1..10000。"
        },
        "expire_at": {
          "type": "string",
          "format": "date-time",
          "title": "过期时间；不设置 = 永不过期。"
        }
      },
      "title": "---- 邀请码（T-03）----"
    },
    "ProjectsServiceUpdateOAuthRedirectAllowlistBody": {
      "type": "object",
      "properties": {
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "整表替换语义（PUT）：非空 = 替换为该列表；空 = 清空（回落默认白名单）。\n条目形状（http/https 绝对 URL、host 非空）由 app 层校验，长度/条数上限\n在此声明。"
        }
      }
    },
    "ProjectsServiceUpdateProjectBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "空值不修改（proto3 optional 表达 presence）"
        },
        "description": {
          "type": "string"
        },
        "registration_policy": {
          "type": "string",
          "title": "注册策略（T-03）：open（默认，现状）/ invite_only（凭有效邀请码注册）/\nclosed（一律拒绝）；未设置 = 不修改。"
        }
      }
    },
    "v1CreateProjectRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "title": "必填；小写字母开头，仅小写字母与数字，最长 28（^[a-z][a-z0-9]{0,27}$）。"
        }
      }
    },
    "v1Empty": {
      "type": "object"
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\n见 internal/infra/server/errors.go）：\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1InviteCode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "title": "明文邀请码（twi_ 前缀随机串）。创建响应返回全量；列表亦回显\n（邀请码是分发给被邀请者的明文凭证，管理端需可复制重发；\n泄露风险由一次性/次数上限/过期/可吊销控制）。"
        },
        "max_uses": {
          "type": "integer",
          "format": "int32"
        },
        "used_count": {
          "type": "integer",
          "format": "int32"
        },
        "expire_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked": {
          "type": "boolean"
        },
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1ListInviteCodesResponse": {
      "type": "object",
      "properties": {
        "invite_codes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1InviteCode"
          }
        },
        "meta": {
          "$ref": "#/definitions/v1ListResponseMeta"
        }
      }
    },
    "v1ListProjectsResponse": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Project"
          }
        },
        "meta": {
          "$ref": "#/definitions/v1ListResponseMeta"
        }
      }
    },
    "v1ListResponseMeta": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "next_page_token": {
          "type": "string"
        },
        "prev_page_token": {
          "type": "string"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "title": "total_count ≤0 = unknown（keyset 分页下 0 与空集合不可区分，调用方应以 next_page_token 是否为空判定是否还有更多；≤0 表示总数未知）。"
        }
      }
    },
    "v1Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "registration_policy": {
          "type": "string",
          "title": "注册策略：open / invite_only / closed（T-03；默认 open）。"
        },
        "oauth_allowed_redirect_urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "OAuth 重定向白名单（settings key auth.oauth_allowed_redirect_urls 的\n投影，仅投影该 key 不透出其余 settings）。空 = 未配置，回落默认白名单\n（localhost 系列 + 本站 public_url origin）。"
        }
      }
    },
    "v1SortOrder": {
      "type": "string",
      "enum": [
        "SORT_ORDER_UNSPECIFIED",
        "SORT_ORDER_ASC",
        "SORT_ORDER_DESC"
      ],
      "default": "SORT_ORDER_UNSPECIFIED",
      "title": "SortOrder 是时间列排序方向（Console 列表页「按创建时间正/倒序」）。\n固定排序键 = 各端点的时间列（通常 created_at），不是 AIP-160 任意列\norder_by（W-K 终结裁决维持：filter/order_by 不复活）。UNSPECIFIED =\n各端点历史默认（created_at DESC，最新在前）。keyset 游标与方向耦合，\n换向必须从第一页重新开始，携带异向游标即 InvalidArgument。"
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "Format: Bearer \u003cjwt\u003e",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "The project is bound to the API key row; X-Torchwood-Project is not needed. This header is only for Console admin sessions switching projects.",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e (Console admin session)",
      "name": "Cookie",
      "in": "header"
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "x-torchwood-access": "server"
}
