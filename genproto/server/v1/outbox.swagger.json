{
  "swagger": "2.0",
  "info": {
    "title": "server/v1/outbox.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "OutboxService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/server/outbox/dead-letters": {
      "get": {
        "operationId": "OutboxService_ListDeadLetters",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListDeadLettersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "OutboxService"
        ]
      }
    },
    "/v1/server/outbox/dead-letters/{event_id}:replay": {
      "post": {
        "operationId": "OutboxService_ReplayDeadLetter",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ReplayDeadLetterResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OutboxServiceReplayDeadLetterBody"
            }
          }
        ],
        "tags": [
          "OutboxService"
        ]
      }
    }
  },
  "definitions": {
    "OutboxServiceReplayDeadLetterBody": {
      "type": "object",
      "title": "ReplayDeadLetterRequest 同上：项目上下文来自凭证，不做请求体寻址。"
    },
    "v1DeadLetter": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "payload": {
          "type": "string",
          "format": "byte"
        },
        "attempts": {
          "type": "integer",
          "format": "int32"
        },
        "last_error": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\r\n见 internal/infra/server/errors.go）：\r\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\r\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\r\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\r\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\r\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\r\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\r\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\r\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\r\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\r\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1ListDeadLettersResponse": {
      "type": "object",
      "properties": {
        "dead_letters": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DeadLetter"
          }
        },
        "meta": {
          "$ref": "#/definitions/v1ListResponseMeta"
        }
      }
    },
    "v1ListResponseMeta": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "next_page_token": {
          "type": "string"
        },
        "prev_page_token": {
          "type": "string"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "title": "total_count ≤0 = unknown（keyset 分页下 0 与空集合不可区分，调用方应以 next_page_token 是否为空判定是否还有更多；≤0 表示总数未知）。"
        }
      }
    },
    "v1ReplayDeadLetterResponse": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "Bearer \u003cjwt\u003e",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "API key",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e",
      "name": "Cookie",
      "in": "header"
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "x-torchwood-access": "server"
}
