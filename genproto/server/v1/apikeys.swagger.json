{
  "swagger": "2.0",
  "info": {
    "title": "server/v1/apikeys.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "APIKeysService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/server/api-keys": {
      "get": {
        "operationId": "APIKeysService_ListAPIKeys",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAPIKeysResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "enabled",
            "description": "启用状态精确过滤（proto3 optional：未设置 = 不过滤）。",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "APIKeysService"
        ]
      },
      "post": {
        "operationId": "APIKeysService_CreateAPIKey",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1APIKeyWithSecret"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateAPIKeyRequest"
            }
          }
        ],
        "tags": [
          "APIKeysService"
        ]
      }
    },
    "/v1/server/api-keys/whoami": {
      "get": {
        "summary": "WhoAmI 返回调用凭证（X-API-Key）自身对应的 key 行（whoami）。",
        "description": "认证形态为\"自证凭证型\"（ACCESS_LEVEL_PUBLIC + 不要求任何 scope）：出示 key\n明文本身就是查询授权——任何有效 key 可查自己，零信息泄露、零自铸面；\n不要求 scope 意味着零 scope key 也可用。无效/禁用/过期/删除 → 401\n（每请求读库校验，与请求侧认证同路径）；匿名/非 API key 凭证（admin\n会话等）无可述的 key，handler 返回 401。\n响应不含 secret（永不回显）；max_age_seconds 由服务端以服务器时钟计算\n（相对时间，规避客户端时钟偏斜）。",
        "operationId": "APIKeysService_WhoAmI",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1WhoAmIResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "APIKeysService"
        ],
        "security": [],
        "x-torchwood-access": "public"
      }
    },
    "/v1/server/api-keys/{id}": {
      "get": {
        "operationId": "APIKeysService_GetAPIKey",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1APIKey"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "APIKeysService"
        ]
      },
      "delete": {
        "operationId": "APIKeysService_DeleteAPIKey",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Empty"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "APIKeysService"
        ]
      },
      "patch": {
        "summary": "更新 key 治理字段（T-02）：可改 name/scopes/enabled/expire_at；\nsecret 无原地轮换——平滑轮换 = 新建 key + 双 key 并存过渡 + 旧 key\n经本方法设 expire_at 下线（见 09-api-guide.md 轮换流程）。禁用/过期\n立即生效（每请求鉴权读库校验）。",
        "operationId": "APIKeysService_UpdateAPIKey",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1APIKey"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/APIKeysServiceUpdateAPIKeyBody"
            }
          }
        ],
        "tags": [
          "APIKeysService"
        ]
      }
    }
  },
  "definitions": {
    "APIKeysServiceUpdateAPIKeyBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "以下字段 proto3 optional：未设置 = 不修改；设置（含 enabled=false）= 更新。"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "expire_at": {
          "type": "string",
          "format": "date-time",
          "title": "新过期时间；设置 = 更新（不提供\"清除过期\"语义——永不过期请删除重建）。"
        }
      }
    },
    "v1APIKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "expire_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1APIKeyWithSecret": {
      "type": "object",
      "properties": {
        "api_key": {
          "$ref": "#/definitions/v1APIKey"
        },
        "secret": {
          "type": "string",
          "title": "明文 API key secret，仅创建响应返回一次，之后任何接口不再回显\n（持久层仅存哈希；泄露需删除重建）。"
        }
      }
    },
    "v1CreateAPIKeyRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expire_at": {
          "type": "string",
          "format": "date-time",
          "title": "过期时间；不设置 = 永不过期（RFC3339，经 gateway 序列化为字符串）。"
        }
      }
    },
    "v1Empty": {
      "type": "object"
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\n见 internal/infra/server/errors.go）：\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1ListAPIKeysResponse": {
      "type": "object",
      "properties": {
        "api_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1APIKey"
          }
        },
        "meta": {
          "$ref": "#/definitions/v1ListResponseMeta"
        }
      }
    },
    "v1ListResponseMeta": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "next_page_token": {
          "type": "string"
        },
        "prev_page_token": {
          "type": "string"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "title": "total_count ≤0 = unknown（keyset 分页下 0 与空集合不可区分，调用方应以 next_page_token 是否为空判定是否还有更多；≤0 表示总数未知）。"
        }
      }
    },
    "v1WhoAmIResponse": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "title": "key 唯一 ID（非显示名：审计/归因/allow 列表按本 ID 匹配）。"
        },
        "name": {
          "type": "string",
          "title": "key 显示名。"
        },
        "project_id": {
          "type": "string",
          "title": "key 所属 project id。当前数据模型 key 恒绑定项目（api_keys.project_id\nNOT NULL）；平台级 key（空 project）需 schema 迁移，暂未支持。"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "该 key 的 scope 列表原样：TW 内建词表形态 + `\u003cservice\u003e.\u003cname\u003e` 自定义\n语法（TW 只存不解释，语义归各服务）。"
        },
        "max_age_seconds": {
          "type": "string",
          "format": "int64",
          "title": "服务端计算：key 设了 expire_at → max(0, expire_at - now) 秒；未设置 = 0。\n相对时间规避客户端/服务端时钟偏斜。已过期 key 不会到达本方法（认证层\n即 401），此处钳 0 为防御。"
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "Format: Bearer \u003cjwt\u003e",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "The project is bound to the API key row; X-Torchwood-Project is not needed. This header is only for Console admin sessions switching projects.",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e (Console admin session)",
      "name": "Cookie",
      "in": "header"
    }
  },
  "security": [
    {
      "cookie": []
    }
  ],
  "x-torchwood-access": "permission"
}
