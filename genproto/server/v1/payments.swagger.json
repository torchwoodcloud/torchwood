{
  "swagger": "2.0",
  "info": {
    "title": "server/v1/payments.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "PaymentsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/server/payments/orders": {
      "get": {
        "operationId": "PaymentsService_ListOrders",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListOrdersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "queries",
            "description": "queries 是静态表面遗留的 Appwrite 风格 DSL 串通道，与文档查询栈的单\ntyped AST（shared.v1.Query）相互独立。消费面：users ListUsers 经\nParseUserList 白名单解析（equal/greaterThan/lessThan + 白名单属性）；\nstorage buckets/files 与 groups（ListGroups/ListMemberships）不支持——\n携带即 InvalidArgument（显式拒绝，不静默忽略）；其余使用本消息的面以\n各自 handler 的显式行为为准。",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          }
        ],
        "tags": [
          "PaymentsService"
        ]
      }
    },
    "/v1/server/payments/orders/{order_id}": {
      "get": {
        "operationId": "PaymentsService_GetOrder",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodserverv1PaymentOrder"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "PaymentsService"
        ]
      }
    },
    "/v1/server/payments/orders/{order_id}:fulfill": {
      "post": {
        "operationId": "PaymentsService_ManualFulfill",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ManualFulfillResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PaymentsServiceManualFulfillBody"
            }
          }
        ],
        "tags": [
          "PaymentsService"
        ]
      }
    },
    "/v1/server/payments/orders/{order_id}:refund": {
      "post": {
        "operationId": "PaymentsService_Refund",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/torchwoodserverv1PaymentOrder"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PaymentsServiceRefundBody"
            }
          }
        ],
        "tags": [
          "PaymentsService"
        ]
      }
    }
  },
  "definitions": {
    "PaymentsServiceManualFulfillBody": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        }
      },
      "title": "ManualFulfillRequest 人工标记履约完成（订单已支付但履约异常时的兜底）。"
    },
    "PaymentsServiceRefundBody": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "format": "int64",
          "title": "退款金额（最小货币单位）；缺省/0 = 全额退款。"
        },
        "reason": {
          "type": "string",
          "title": "备注（审计用途，可选）。"
        }
      },
      "title": "RefundRequest 对已支付订单发起退款（D12：一期只翻订单状态 + 事件，\n不回收已发放资产）。"
    },
    "protobufNullValue": {
      "type": "string",
      "enum": [
        "NULL_VALUE"
      ],
      "default": "NULL_VALUE",
      "description": "`NullValue` is a singleton enumeration to represent the null value for the\n`Value` type union.\n\nThe JSON representation for `NullValue` is JSON `null`.\n\n - NULL_VALUE: Null value."
    },
    "torchwoodserverv1PaymentOrder": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "amount": {
          "type": "string",
          "format": "int64"
        },
        "currency": {
          "type": "string"
        },
        "purpose_kind": {
          "type": "string",
          "title": "topup | item_purchase | subscription"
        },
        "purpose": {
          "type": "object"
        },
        "status": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "provider_session_id": {
          "type": "string",
          "title": "渠道会话 / 渠道支付单（Stripe cs_... / pi_...）。"
        },
        "provider_order_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "paid_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "PaymentOrder 是支付订单（v3 设计 §1.3）。amount 一律最小货币单位的\nint64（禁止 float）；status 状态机：\ncreated → paying → paid | failed | closed → refunding → refunded。"
    },
    "v1Error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error_id": {
          "type": "string"
        },
        "error_code": {
          "$ref": "#/definitions/v1ErrorCode"
        }
      }
    },
    "v1ErrorCode": {
      "type": "string",
      "enum": [
        "ERROR_CODE_UNSPECIFIED",
        "ERROR_CODE_INVALID_REQUEST",
        "ERROR_CODE_RESOURCE_NOT_FOUND",
        "ERROR_CODE_INVALID_CREDENTIALS",
        "ERROR_CODE_PERMISSION_DENIED",
        "ERROR_CODE_RESOURCE_CONFLICT",
        "ERROR_CODE_QUOTA_EXCEEDED",
        "ERROR_CODE_PRECONDITION_FAILED",
        "ERROR_CODE_CONCURRENT_MODIFICATION",
        "ERROR_CODE_VALUE_OUT_OF_RANGE",
        "ERROR_CODE_OPERATION_NOT_ALLOWED",
        "ERROR_CODE_INTERNAL_ERROR",
        "ERROR_CODE_SERVICE_UNAVAILABLE",
        "ERROR_CODE_TIMEOUT"
      ],
      "default": "ERROR_CODE_UNSPECIFIED",
      "title": "ErrorCode 与 gRPC code 的映射（HTTPErrorHandler 单一事实来源，\r\n见 internal/infra/server/errors.go）：\r\n  - InvalidArgument → ERROR_CODE_INVALID_REQUEST\r\n  - FailedPrecondition → ERROR_CODE_PRECONDITION_FAILED\r\n  - NotFound → ERROR_CODE_RESOURCE_NOT_FOUND\r\n  - AlreadyExists → ERROR_CODE_RESOURCE_CONFLICT\r\n  - Aborted → ERROR_CODE_CONCURRENT_MODIFICATION\r\n  - Unauthenticated → ERROR_CODE_INVALID_CREDENTIALS\r\n  - PermissionDenied → ERROR_CODE_PERMISSION_DENIED\r\n  - ResourceExhausted → ERROR_CODE_QUOTA_EXCEEDED\r\n  - DeadlineExceeded → ERROR_CODE_TIMEOUT\r\n  - 其余 → ERROR_CODE_INTERNAL_ERROR"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/v1Error"
        }
      }
    },
    "v1Fulfillment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "order_id": {
          "type": "string"
        },
        "purpose_kind": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "title": "履约 ref（幂等锚点三：order:{order_id}；PR2 起指向资产 ledger entry）。"
        },
        "status": {
          "type": "string",
          "title": "pending | done | failed"
        },
        "detail": {
          "type": "object"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "Fulfillment 是履约记录（v3 设计 §1.5；PR1 为占位记录，PR2 联通资产发放）。"
    },
    "v1ListOrdersResponse": {
      "type": "object",
      "properties": {
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/torchwoodserverv1PaymentOrder"
          }
        },
        "meta": {
          "$ref": "#/definitions/v1ListResponseMeta"
        }
      }
    },
    "v1ListResponseMeta": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "next_page_token": {
          "type": "string"
        },
        "prev_page_token": {
          "type": "string"
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "title": "total_count ≤0 = unknown（keyset 分页下 0 与空集合不可区分，调用方应以 next_page_token 是否为空判定是否还有更多；≤0 表示总数未知）。"
        }
      }
    },
    "v1ManualFulfillResponse": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/definitions/torchwoodserverv1PaymentOrder"
        },
        "fulfillment": {
          "$ref": "#/definitions/v1Fulfillment"
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "格式: Bearer \u003cjwt\u003e",
      "name": "Authorization",
      "in": "header"
    },
    "apiKey": {
      "type": "apiKey",
      "description": "项目绑定在密钥行上，不需要 X-Torchwood-Project。该头仅 Console admin 会话切换项目。",
      "name": "X-API-Key",
      "in": "header"
    },
    "cookie": {
      "type": "apiKey",
      "description": "TORCHWOOD_session_console=\u003csid\u003e（Console admin 会话）",
      "name": "Cookie",
      "in": "header"
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "x-torchwood-access": "server"
}
