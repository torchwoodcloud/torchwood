{
  "name": "@torchwood/sdk",
  "version": "0.3.0",
  "description": "Torchwood Client API and Server API TypeScript SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/__tests__/*.test.js\"",
    "prepublishOnly": "npm run test && npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "torchwood",
    "sdk",
    "backend",
    "api",
    "grpc",
    "agent"
  ],
  "author": "Torchwood",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torchwooddev/torchwood.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/torchwooddev/torchwood/tree/main/sdk/typescript#readme",
  "bugs": {
    "url": "https://github.com/torchwooddev/torchwood/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
