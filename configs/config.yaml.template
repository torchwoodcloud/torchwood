server:
  # 关停排水不在 YAML：TORCHWOOD_ENV=development 跳过排水；production（默认）30s。
  # 覆盖：TORCHWOOD_SERVER_DRAIN_TIMEOUT=0s|30s
  http:
    addr: ":9080"
    timeout: "60s"
    public_url: "http://localhost:9080"
    cors:
      allow_origins: ["http://torchwood.local:9099"]  # set explicit origins; "*" is rejected when allow_credentials=true
      allow_methods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
      allow_headers: ["Content-Type", "Authorization", "X-Api-Key", "X-Torchwood-Project", "X-Request-Id", "X-Correlation-Id", "Idempotency-Key"]
      allow_credentials: true
      max_age: 3600
  grpc:
    # gRPC 端口仅限本机回环（gateway 同机转发）；生产如需外部 gRPC 客户端访问，请配置 TLS 或经网络策略隔离
    addr: "127.0.0.1:9060"
    timeout: "30s"
  metrics:
    # 默认仅回环监听（metrics 无鉴权）；生产走反向代理 + 网络策略
    addr: "127.0.0.1:9040"

security:
  jwt:
    secret: ""              # env: TORCHWOOD_SECURITY_JWT_SECRET
    access_ttl: "15m"
    refresh_ttl: "7d"
  # 独立静态加密密钥（OAuth client secret / TOTP secret，secretbox AES-256-GCM）。
  # 可选；未配置时回退 jwt.secret（启动告警）。建议配置独立密钥 ≥32 字符。
  encryption_key: ""       # env: TORCHWOOD_SECURITY_ENCRYPTION_KEY
  api_key:
    header: "x-api-key"
  # Console 首个管理员引导令牌；未设置时 Console SignUp 被拒绝。
  # 部署时生成强随机值，例如：openssl rand -hex 32
  setup_token: ""           # env: TORCHWOOD_SECURITY_SETUP_TOKEN
  # 可信代理网段（CIDR）。仅当直连 peer 命中时才采纳 X-Forwarded-For 首跳；
  # 默认空 = 只信 peer 地址。grpc-gateway 与 gRPC 同进程部署时需包含 127.0.0.1/32 才能恢复客户端真实 IP。
  trusted_proxies: []         # env: TORCHWOOD_SECURITY_TRUSTED_PROXIES（逗号分隔）
  sessions:
    # 单用户最大并发会话数；未配置/0 = 默认 50；-1 = 不限。
    max_per_user: 50          # env: TORCHWOOD_SECURITY_SESSIONS_MAX_PER_USER
  # 通用 API 限流（gRPC 管道全量生效，gateway 流量经同一拦截器）：
  # API Key > user > IP 三维度各按命中一个计数，超限返回 429；
  # 与注册/匿名会话等局部限流叠加不冲突。维度 limit/window 未配置时使用
  # 内置默认值（ip 300/60s、user 1000/60s、api_key 6000/60s）。
  rate_limit:
    # 总开关，默认 true（未配置视为开启）；仅显式设为 false 关闭。
    enabled: true             # env: TORCHWOOD_SECURITY_RATE_LIMIT_ENABLED
    ip:
      # 未认证请求按客户端 IP 计数（IP 经 trusted_proxies 校验）。
      limit: 300              # env: TORCHWOOD_SECURITY_RATE_LIMIT_IP_LIMIT
      window: "60s"           # env: TORCHWOOD_SECURITY_RATE_LIMIT_IP_WINDOW
    user:
      # user/session principal 按 ActorID 计数。
      limit: 1000             # env: TORCHWOOD_SECURITY_RATE_LIMIT_USER_LIMIT
      window: "60s"           # env: TORCHWOOD_SECURITY_RATE_LIMIT_USER_WINDOW
    api_key:
      # API Key principal 按 key 计数（Agent/自动化调用量更高）。
      limit: 6000             # env: TORCHWOOD_SECURITY_RATE_LIMIT_API_KEY_LIMIT
      window: "60s"           # env: TORCHWOOD_SECURITY_RATE_LIMIT_API_KEY_WINDOW
  # 认证面局部频控（登录失败双维计数 + 注册 IP 频控；T-01）。
  # 失败计数语义：密码错误双维计数、未注册邮箱只计 IP 维度、登录成功清零。
  # 超限 429 + Retry-After；维度未配置时使用内置默认值。
  login_throttle:
    email:
      # 按账号（email 小写规范化）的失败计数上限。
      limit: 5                # env: TORCHWOOD_SECURITY_LOGIN_THROTTLE_EMAIL_LIMIT
      window: "60s"           # env: TORCHWOOD_SECURITY_LOGIN_THROTTLE_EMAIL_WINDOW
    ip:
      # 按来源 IP（trusted_proxies 校验后）的失败计数上限。
      limit: 5                # env: TORCHWOOD_SECURITY_LOGIN_THROTTLE_IP_LIMIT
      window: "60s"           # env: TORCHWOOD_SECURITY_LOGIN_THROTTLE_IP_WINDOW
    signup_ip:
      # 按来源 IP 的注册频控。
      limit: 10               # env: TORCHWOOD_SECURITY_LOGIN_THROTTLE_SIGNUP_IP_LIMIT
      window: "1h"            # env: TORCHWOOD_SECURITY_LOGIN_THROTTLE_SIGNUP_IP_WINDOW
    api_key_auth:
      # X-API-Key 认证失败按来源 IP 的频控（T-02）。
      limit: 10               # env: TORCHWOOD_SECURITY_LOGIN_THROTTLE_API_KEY_AUTH_LIMIT
      window: "60s"           # env: TORCHWOOD_SECURITY_LOGIN_THROTTLE_API_KEY_AUTH_WINDOW

data:
  database:
    # 运行态 DSN 必须是非 superuser authenticator 账号（tw_authenticator，
    # 创建 SQL 与验证见 docs/developer/13-operations.md §4.5）——superuser 会
    # 绕过文档面 RLS policy（fail-closed 失效）。迁移/扩展引导用 owner 引导
    # 账号（仅部署期 migrate 作业注入该环境变量，不写入运行时配置）。
    source: ""              # env: TORCHWOOD_DATA_DATABASE_SOURCE
    debug: false
    slow_query_threshold: "500ms"   # 慢查询日志阈值；"0" 禁用；env: TORCHWOOD_DATA_DATABASE_SLOW_QUERY_THRESHOLD
    pool:
      max_idle_conns: 4
      max_open_conns: 16
      conn_max_lifetime: "1h"
      conn_max_idle_time: "30m"
  redis:
    addr: "127.0.0.1:6379"
    password: ""            # env: TORCHWOOD_DATA_REDIS_PASSWORD
    db: 0

storage:
  provider: "s3"            # or "minio" / "local"
  s3:
    endpoint: ""            # env: TORCHWOOD_STORAGE_S3_ENDPOINT
    region: "us-east-1"
    bucket: "torchwood-storage"   # S3/MinIO 要求全小写
    access_key_id: ""       # env: TORCHWOOD_STORAGE_S3_ACCESS_KEY_ID
    secret_access_key: ""   # env: TORCHWOOD_STORAGE_S3_SECRET_ACCESS_KEY
  local:
    path: "./data/files"

functions:
  executor: "docker"
  docker:
    host: "unix:///var/run/docker.sock"
    # 函数执行容器网络。默认（留空/删除本键）为 per-project 隔离网络
    # tw-func-<project_id>：项目间函数容器互不可达（Round4 J5-4）。
    # 显式配置全局网络为 opt-in：所有项目的函数容器同网互通、可互相解析
    # IP，存在跨租户横向访问风险！仅在单租户/完全可信环境使用。
    network: ""                       # env: TORCHWOOD_FUNCTIONS_DOCKER_NETWORK
    registry: "torchwood-funcs"      # 必须小写（docker build -t 校验）

payments:
  stripe:
    # 渠道 secret 一律走环境变量（v3 设计 §Security：不写入 config.yaml）：
    #   TORCHWOOD_PAYMENTS_STRIPE_SECRET_KEY      (sk_...)
    #   TORCHWOOD_PAYMENTS_STRIPE_WEBHOOK_SECRET  (whsec_...)
    # 未配置时服务可启动，支付操作 fail-closed；api_base_url 仅供测试注入。
    api_base_url: ""         # env: TORCHWOOD_PAYMENTS_STRIPE_API_BASE_URL（空 = https://api.stripe.com）
  wechat:
    mch_id: ""               # env: TORCHWOOD_PAYMENTS_WECHAT_MCH_ID
    app_id: ""               # env: TORCHWOOD_PAYMENTS_WECHAT_APP_ID
    # secret 走环境变量，不写入本文件：
    #   TORCHWOOD_PAYMENTS_WECHAT_API_V3_KEY
    #   TORCHWOOD_PAYMENTS_WECHAT_MERCHANT_SERIAL_NO
    #   TORCHWOOD_PAYMENTS_WECHAT_MERCHANT_PRIVATE_KEY
    #   TORCHWOOD_PAYMENTS_WECHAT_PLATFORM_CERT
    notify_url: ""           # 空 = server.http.public_url + /v1/payments/callbacks/wechat
    api_base_url: ""         # 空 = https://api.mch.weixin.qq.com
  alipay:
    app_id: ""               # env: TORCHWOOD_PAYMENTS_ALIPAY_APP_ID
    # secret 走环境变量：
    #   TORCHWOOD_PAYMENTS_ALIPAY_APP_PRIVATE_KEY
    #   TORCHWOOD_PAYMENTS_ALIPAY_ALIPAY_PUBLIC_KEY
    notify_url: ""           # 空 = server.http.public_url + /v1/payments/callbacks/alipay
    gateway_url: ""          # 空 = https://openapi.alipay.com/gateway.do
  ios_iap:
    bundle_id: ""            # env: TORCHWOOD_PAYMENTS_IOS_IAP_BUNDLE_ID
    # secret 走环境变量：
    #   TORCHWOOD_PAYMENTS_IOS_IAP_SHARED_SECRET
    #   TORCHWOOD_PAYMENTS_IOS_IAP_PRIVATE_KEY
    #   TORCHWOOD_PAYMENTS_IOS_IAP_APPLE_ROOT_CERT（空 = 内置 Apple Root CA G3）
    issuer_id: ""
    key_id: ""
    verify_receipt_url: ""   # 空 = https://buy.itunes.apple.com/verifyReceipt
    sandbox_verify_url: ""   # 空 = https://sandbox.itunes.apple.com/verifyReceipt

telemetry:
  enabled: false
  otlp_endpoint: ""
  service_name: "Torchwood"

messaging:
  smtp:
    host: ""                # env: TORCHWOOD_MESSAGING_SMTP_HOST
    port: 587
    username: ""
    password: ""            # env: TORCHWOOD_MESSAGING_SMTP_PASSWORD
    from: "noreply@torchwood.local"
    use_tls: true
  # dev only：SMTP/SMS 未配置时把验证码打到 stdout；生产环境（TORCHWOOD_ENV
  # 非 development）发送路径会直接拒绝，防止日志泄漏 OTP。默认关闭。
  dev_log_otp: false
  dev_log_sms: false
  sms:
    provider: ""            # twilio
    twilio:
      account_sid: ""       # env: TORCHWOOD_MESSAGING_SMS_TWILIO_ACCOUNT_SID
      auth_token: ""        # env: TORCHWOOD_MESSAGING_SMS_TWILIO_AUTH_TOKEN
      from: ""

idgen:
  default_strategy: uuid    # uuid | ulid | snowflake | sequence | random
  random:
    length: 10
    charset: numeric        # numeric | alphanumeric
    redis_key_prefix: Torchwood:id:random
    max_retries: 10
  snowflake:
    node_id: 0                # env: TORCHWOOD_IDGEN_SNOWFLAKE_NODE_ID
  sequence:
    redis_key_prefix: Torchwood:seq
  resources:
    users: uuid
    sessions: uuid
    documents: uuid
