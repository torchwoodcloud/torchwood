// Torchwood functions Go runner runtime（runner 协议 v5 的 Go 平台实现，
// 与 node 实现 runner.js 同契约同版本；协议事实源：runner.js 头注释与
// docs/design/functions-runtimes-and-sources.md §0/§1）。
//
// 本文件由平台构建期渲染（internal/infra/functions/runner/gorunner/assets/
// runtime.go.tmpl）写入用户构建上下文的保留目录 twmain/，随用户代码一并
// 编译——对用户不可见，协议面经 :18080 HTTP 暴露。
//
// —— import 白名单 = 标准库（硬约束，对抗审查 A3）——
// vendor 模式下 twmain 的依赖同样经 vendor 解析，出现任何第三方依赖都会
// 让 vendor 用户构建失败；render_test 对渲染产物做 stdlib-only 断言防回归。
//
// —— 公开协议演进宪法（契约公开后消费方含平台不可控的 BYO 契约镜像）——
//   - 只加不改不删；
//   - 未知的 x-tw-* header 一律忽略（分发侧可先于本实现演进）；
//   - 响应封套新字段必须可选（消费方防御式解析，未知/缺失字段不致命）。
//
// 双实现同版本纪律：本模板与 runner.js 任一语义变更必须同步另一实现并
// 递增 RunnerTemplateVersion（当前 v5；新增 Go 模板分支不改存量语义，
// 不 bump）。
package main

import (
	"bytes"
	"context"
	"encoding/base64"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"net"
	"net/http"
	"net/http/httptest"
	"net/textproto"
	"os"
	"os/signal"
	"strconv"
	"strings"
	"sync/atomic"
	"syscall"
	"time"
)

// runner 协议常量（与 runner.js 逐项对齐）。
const (
	defaultRunnerPort            = 18080
	defaultMaxRequests           = 1000
	defaultDrainTimeoutMS        = 10000
	defaultRequestTimeoutSeconds = 30
	// maxBodyBytes 请求体上限：普通调用 data ≤ 32KB；HTTP 触发器封套模式下
	// body 为触发器原始 body + main 风格封套注入后的双编码（≈2.4MB），
	// 取 4MB 覆盖（与平台 maxTriggerDataBytes 口径同源，runner.js 同款）。
	maxBodyBytes = 4 << 20
	// maxOutputBytes fetch 风格响应 body 截断上限（平台 64KB 输出截断口径）。
	maxOutputBytes = 64 << 10
)

// responseHeaderBlocklist 是 fetch 风格响应封套的头过滤清单（hop-by-hop +
// 平台头，runner.js RESPONSE_HEADER_BLOCKLIST 逐项对齐）：content-length 由
// 分发链路按实际 body 重算，date/server/host 不得由用户代码冒充；其余头
// （含 content-type）原样透传。
var responseHeaderBlocklist = map[string]bool{
	"connection":       true,
	"keep-alive":       true,
	"proxy-connection": true,
	"te":               true,
	"trailer":          true,
	"transfer-encoding": true,
	"upgrade":          true,
	"content-length":   true,
	"host":             true,
	"date":             true,
	"server":           true,
}

// 运行状态记账（runner.js 同款语义）：served/inFlight 按请求生命周期增减
// （不追踪用户代码生命周期——超时放弃后残跑的 goroutine 不再计入 inflight）；
// shuttingDown 置位后不再接受新调用（drain）。
var (
	served       atomic.Int64
	inFlight     atomic.Int64
	shuttingDown atomic.Bool
	maxRequests  atomic.Int64
)

// entry 是平台 AST 探测（gorunner.DetectEntry）选定的用户入口：编译期绑定，
// node「加载失败常驻 not-ready」的形态在 Go 下不存在——签名不符由编译器
// 报错兜底，构建即失败。双风格优先级同 runner.js：Fetch 优先，Main 兜底，
// 生成期二选一。
type entry struct {
	fetch func(http.ResponseWriter, *http.Request)
	main  func(map[string]any, map[string]string) (any, error)
}

// triggerEnvelopeMeta 是触发器封套元数据（分发 header x-tw-trigger-envelope，
// base64 JSON：{method,path,raw_query,headers}，不含 body，v4 §2.3）。
type triggerEnvelopeMeta struct {
	Method   string          `json:"method"`
	Path     string          `json:"path"`
	RawQuery string          `json:"raw_query"`
	Headers  json.RawMessage `json:"headers"`
}

// runnerReply 是一次调用的响应封套（HTTP 状态 + JSON 载荷）。
type runnerReply struct {
	status  int
	payload map[string]any
}

// serve 启动 runner HTTP 服务并阻塞至进程退出。生命周期三件与 runner.js
// 逐项对齐：TW_MAX_REQUESTS 计数自退出（每响应后计数）、SIGTERM/SIGINT →
// 停止接新请求等在途完成（drain）、TW_DRAIN_TIMEOUT_MS 兜底强退。
func serve(e entry) {
	port := envInt("TW_RUNNER_PORT", defaultRunnerPort)
	maxRequests.Store(int64(envInt("TW_MAX_REQUESTS", defaultMaxRequests)))
	drainTimeout := time.Duration(envInt("TW_DRAIN_TIMEOUT_MS", defaultDrainTimeoutMS)) * time.Millisecond

	addr := fmt.Sprintf("0.0.0.0:%d", port)
	ln, err := net.Listen("tcp", addr)
	if err != nil {
		// 监听失败（端口占用等）：非零退出，dispatcher 健康探针超时回收实例。
		fmt.Fprintln(os.Stderr, "listen "+addr+": "+err.Error())
		os.Exit(1)
	}
	srv := &http.Server{
		Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			route(e, w, r)
		}),
	}

	// SIGTERM/SIGINT → drain：停止接新请求（Shutdown 立即关闭 listener）、
	// 等在途请求完成后退出；TW_DRAIN_TIMEOUT_MS 到点强退（dispatcher 侧
	// 同样有 force kill 兜底）。
	drainDone := make(chan struct{})
	sigs := make(chan os.Signal, 1)
	signal.Notify(sigs, syscall.SIGTERM, syscall.SIGINT)
	go func() {
		<-sigs
		shuttingDown.Store(true)
		_ = srv.Shutdown(context.Background())
		close(drainDone)
	}()

	writeStartupLine(port, e)
	if err := srv.Serve(ln); err != nil && !errors.Is(err, http.ErrServerClosed) {
		fmt.Fprintln(os.Stderr, err.Error())
		os.Exit(1)
	}
	// Serve 返回 = Shutdown 已开始（信号路径）：main 必须陪跑到 drain 结束
	// 再退出，否则进程提前消亡会杀掉在途请求（runner.js server.close 回调
	// 语义的对齐）。
	select {
	case <-drainDone:
	case <-time.After(drainTimeout):
	}
	os.Exit(0)
}

// route 是唯一入口路由：GET /_tw/health 健康探针；POST / 双轨调用；其余
// 一律 404（runner.js 同款）。
func route(e entry, w http.ResponseWriter, r *http.Request) {
	if r.URL.Path == "/_tw/health" {
		if r.Method != http.MethodGet {
			writeJSON(w, http.StatusNotFound, errorPayload("not found"))
			return
		}
		// 入口编译期绑定 → 恒 ready（node 加载失败常驻 not-ready 的形态在
		// Go 下不存在）。
		writeJSON(w, http.StatusOK, map[string]any{
			"ok":       true,
			"ready":    true,
			"served":   served.Load(),
			"inflight": inFlight.Load(),
		})
		return
	}
	if r.Method != http.MethodPost || r.URL.Path != "/" {
		writeJSON(w, http.StatusNotFound, errorPayload("not found"))
		return
	}
	if shuttingDown.Load() {
		// drain 中不再接新请求（连接被拒后由调用方重试到其他实例）。
		writeJSON(w, http.StatusServiceUnavailable, errorPayload("instance draining"))
		return
	}
	raw, ok := readBody(w, r)
	if !ok {
		return
	}
	inFlight.Add(1)

	// 触发器封套元数据（仅 dispatcher 设置）：解析失败视为不存在（内网可信
	// 调用方，异常形态交由调用方协议约束，runner.js 同款）。
	meta := decodeTriggerEnvelope(r.Header.Get("x-tw-trigger-envelope"))

	// per-request 超时（分发 header x-tw-timeout-seconds 缺省 30s）：到点回
	// 500 封套（error 注明 timed out）并放弃等待，双风格一致生效。诚实声明
	// （与 Lambda 同款）：超时后用户代码可能仍在残跑至实例回收；inflight
	// 按请求生命周期在此释放，不追踪用户代码生命周期。
	timeoutSeconds := headerInt(r.Header.Get("x-tw-timeout-seconds"), defaultRequestTimeoutSeconds)

	// 调用身份六件（v3 §1.2 + v5；与 runner.js ctx 逐键对齐）：token 经分发
	// header，apiBaseUrl 来自容器 env TW_API_BASE_URL。source 恒非空——header
	// 缺省/为空回落 "server"（旧分发链路兼容）；未知的 x-tw-* header 一律
	// 忽略（协议演进宪法）。
	callCtx := map[string]string{
		"executionToken": r.Header.Get("x-tw-execution-token"),
		"apiBaseUrl":     os.Getenv("TW_API_BASE_URL"),
		"executionId":    r.Header.Get("x-tw-execution-id"),
		"source":         r.Header.Get("x-tw-source"),
		"invokingUserId": r.Header.Get("x-tw-invoking-user-id"),
		"projectId":      r.Header.Get("x-tw-project-id"),
	}
	if callCtx["source"] == "" {
		callCtx["source"] = "server"
	}

	entryName := "Main()"
	if e.fetch != nil {
		entryName = "Fetch()"
	}

	// 缓冲 1：超时放弃等待后，残跑 goroutine 的发送不泄漏、不阻塞。
	finished := make(chan *runnerReply, 1)
	go func() {
		finished <- invoke(e, meta, raw, callCtx)
	}()

	timer := time.NewTimer(time.Duration(timeoutSeconds) * time.Second)
	defer timer.Stop()
	select {
	case reply := <-finished:
		writeJSON(w, reply.status, reply.payload)
	case <-timer.C:
		writeJSON(w, http.StatusInternalServerError, errorPayload(
			entryName+" timed out after "+strconv.Itoa(timeoutSeconds)+
				"s (runner abandoned the request; the function may keep running until the instance is recycled)"))
	}
	served.Add(1)
	inFlight.Add(-1)
	maybeRecycle(w)
}

// invoke 执行用户入口并产出响应封套（在独立 goroutine 中运行：per-request
// 超时到点放弃等待，goroutine 残跑同 node）。panic 捕获为 500 错误封套——
// 用户 panic 不得杀掉常驻实例（node 同步 throw 同款语义）。
func invoke(e entry, meta *triggerEnvelopeMeta, raw []byte, callCtx map[string]string) (reply *runnerReply) {
	defer func() {
		if rec := recover(); rec != nil {
			reply = errorReply(fmt.Sprintf("panic: %v", rec))
		}
	}()
	if e.fetch != nil {
		return runFetch(e.fetch, meta, raw)
	}
	data, err := buildTWData(meta, raw)
	if err != nil {
		// TW_DATA 解析失败 → 400 invalid request（node JSON.parse 错误
		// 同款形态）。
		return &runnerReply{
			status:  http.StatusBadRequest,
			payload: errorPayload("invalid request: " + err.Error()),
		}
	}
	return runMain(e.main, data, callCtx)
}

// runMain 是 main 风格收尾：Main(data, ctx) 返回值封套为
// 200 {ok, result, stdout, stderr}——stdout/stderr 恒空串（Go 无 per-request
// 捕获，日志走容器 stdout / docker logs，设计 D15，诚实字段位）。错误返回
// → 500 {ok:false, error}；返回值不可 JSON 序列化（chan/func/环引用）→
// 500 错误封套（runner.js JSON.parse(JSON.stringify()) 守卫的对齐）。
func runMain(fn func(map[string]any, map[string]string) (any, error), data map[string]any, callCtx map[string]string) *runnerReply {
	result, err := fn(data, callCtx)
	if err != nil {
		return errorReply(err.Error())
	}
	payload, mErr := json.Marshal(result)
	if mErr != nil {
		return errorReply("main() result is not JSON-serializable: " + mErr.Error())
	}
	return &runnerReply{
		status: http.StatusOK,
		payload: map[string]any{
			"ok":      true,
			"result":  json.RawMessage(payload),
			"stdout":  "",
			"stderr":  "",
		},
	}
}

// runFetch 是 fetch 风格收尾（v4 §2.2/§2.4）：触发器封套还原为真
// *http.Request（无封套 = POST http://function/ body=TW_DATA，§2.2 invoke
// 与 cron 语义），用户响应经 httptest.ResponseRecorder 同构捕获 → fetch
// 封套 {ok, status, headers, body_base64, truncated}——status/headers/
// body_base64 恒在，无损承载二进制响应；body 超 64KB 截断标 truncated。
func runFetch(fn func(http.ResponseWriter, *http.Request), meta *triggerEnvelopeMeta, raw []byte) *runnerReply {
	req, err := buildFetchRequest(meta, raw)
	if err != nil {
		return errorReply("invalid request: " + err.Error())
	}
	rec := httptest.NewRecorder()
	fn(rec, req)
	resp := rec.Result()
	body, err := io.ReadAll(resp.Body)
	if err != nil {
		return errorReply("read Response body failed: " + err.Error())
	}
	truncated := false
	if len(body) > maxOutputBytes {
		body = body[:maxOutputBytes]
		truncated = true
	}
	headers := map[string]string{}
	// 同名多值合并为逗号连接（规范 combined 值，runner.js Headers 迭代
	// 同构；Set-Cookie 类单值语义例外一期不做）。
	for k, vs := range resp.Header {
		lk := strings.ToLower(k)
		if responseHeaderBlocklist[lk] {
			continue
		}
		headers[lk] = strings.Join(vs, ",")
	}
	return &runnerReply{
		status: http.StatusOK,
		payload: map[string]any{
			"ok":          true,
			"status":      resp.StatusCode,
			"headers":     headers,
			"body_base64": base64.StdEncoding.EncodeToString(body),
			"truncated":   truncated,
			"stdout":      "",
			"stderr":      "",
		},
	}
}

// buildFetchRequest 构造 fetch 风格 Request（v4 §2.3 封套还原 / §2.2 invoke
// 语义）：有封套 → url = http://trigger{path}?{raw_query}、headers 原样
// （单值/多值形态均承载）、body = 分发 HTTP body 本身（封套模式下
// dispatcher 发的是触发器原始 body 而非 TW_DATA；GET/HEAD 不允许 body，
// 置空）；无封套 → POST http://function/ body=TW_DATA。
func buildFetchRequest(meta *triggerEnvelopeMeta, raw []byte) (*http.Request, error) {
	if meta == nil {
		req, err := http.NewRequest(http.MethodPost, "http://function/", bytes.NewReader(raw))
		if err != nil {
			return nil, err
		}
		req.Header.Set("Content-Type", "application/json")
		return req, nil
	}
	method := strings.ToUpper(meta.Method)
	if method == "" {
		method = http.MethodGet
	}
	path := meta.Path
	if path == "" {
		path = "/"
	}
	url := "http://trigger" + path
	if meta.RawQuery != "" {
		url += "?" + meta.RawQuery
	}
	var bodyReader io.Reader
	if method != http.MethodGet && method != http.MethodHead && len(raw) > 0 {
		bodyReader = bytes.NewReader(raw)
	}
	req, err := http.NewRequest(method, url, bodyReader)
	if err != nil {
		return nil, err
	}
	// 键规范化为 MIME canonical 形态：用户代码按 r.Header.Get（内部做同样
	// 规范化）与 range 迭代两态都可达。
	for k, vs := range meta.headerValues() {
		req.Header[textproto.CanonicalMIMEHeaderKey(k)] = vs
	}
	return req, nil
}

// buildTWData 组装 main 风格 TW_DATA（v4 §2.3「与现状等价」/D9 双轨）：
// 无封套 = 分发 body 即 TW_DATA JSON（server/client invoke 与 cron 语义，
// 空 body 归一为空对象）；有封套 = 元数据 + body 重组 TW_DATA（与 handler
// 构建的封套逐字段同构：body best-effort UTF-8、body_base64 无损）。
func buildTWData(meta *triggerEnvelopeMeta, raw []byte) (map[string]any, error) {
	if meta == nil {
		if len(strings.TrimSpace(string(raw))) == 0 {
			return map[string]any{}, nil
		}
		var data map[string]any
		if err := json.Unmarshal(raw, &data); err != nil {
			return nil, err
		}
		return data, nil
	}
	headers := map[string]any{}
	for k, vs := range meta.headerValues() {
		if len(vs) == 1 {
			headers[k] = vs[0]
			continue
		}
		headers[k] = vs
	}
	return map[string]any{
		"method":      meta.Method,
		"path":        meta.Path,
		"raw_query":   meta.RawQuery,
		"headers":     headers,
		"body":        string(raw),
		"body_base64": base64.StdEncoding.EncodeToString(raw),
	}, nil
}

// headerValues 解码封套 headers 的单值/多值形态（JSON value 为 string 或
// []string，dispatcher 侧构建形态）。解码失败按空处理（封套解析失败视为
// 不存在的同款容错）。
func (m *triggerEnvelopeMeta) headerValues() map[string][]string {
	out := map[string][]string{}
	if m == nil || len(m.Headers) == 0 {
		return out
	}
	var pairs map[string]json.RawMessage
	if json.Unmarshal(m.Headers, &pairs) != nil {
		return out
	}
	for k, v := range pairs {
		var multi []string
		if json.Unmarshal(v, &multi) == nil {
			out[k] = multi
			continue
		}
		var single string
		if json.Unmarshal(v, &single) == nil {
			out[k] = []string{single}
		}
	}
	return out
}

// decodeTriggerEnvelope 解码分发 header（base64 JSON）：失败/为空视为
// 不存在（返回 nil）。
func decodeTriggerEnvelope(v string) *triggerEnvelopeMeta {
	if v == "" {
		return nil
	}
	raw, err := base64.StdEncoding.DecodeString(v)
	if err != nil {
		return nil
	}
	var meta triggerEnvelopeMeta
	if json.Unmarshal(raw, &meta) != nil {
		return nil
	}
	return &meta
}

// readBody 读取分发 body（上限 4MB，超限 413——node MAX_BODY_BYTES 同款）。
func readBody(w http.ResponseWriter, r *http.Request) ([]byte, bool) {
	raw, err := io.ReadAll(http.MaxBytesReader(w, r.Body, maxBodyBytes))
	if err != nil {
		writeJSON(w, http.StatusRequestEntityTooLarge, errorPayload("request body too large"))
		return nil, false
	}
	return raw, true
}

// maybeRecycle 自回收（v2 既有语义，runner.js maybeRecycle 对齐）：每响应
// 后计数达 TW_MAX_REQUESTS（≤0 = 不限）主动退出，dispatcher 检测退出后补位。
// net/http 响应有缓冲：必须先 Flush 把响应推到连接再退出，否则响应可能
// 滞留缓冲被丢弃（node res.end 同步送达语义的对齐）。
func maybeRecycle(w http.ResponseWriter) {
	limit := maxRequests.Load()
	if limit <= 0 || served.Load() < limit {
		return
	}
	if f, ok := w.(http.Flusher); ok {
		f.Flush()
	}
	os.Exit(0)
}

// errorPayload 统一错误封套：stdout/stderr 恒空串（Go 无 per-request 捕获，
// 设计 D15；字段位保留，消费方防御式解析）。
func errorPayload(msg string) map[string]any {
	return map[string]any{"ok": false, "error": msg, "stdout": "", "stderr": ""}
}

func errorReply(msg string) *runnerReply {
	return &runnerReply{status: http.StatusInternalServerError, payload: errorPayload(msg)}
}

// writeJSON 输出响应封套。写回失败一律吞掉：调用方（dispatcher ctx 超时
// 先行）可能已断开，ECONNRESET/写后错误不影响实例与记账（runner.js 同款）。
func writeJSON(w http.ResponseWriter, status int, payload any) {
	body, err := json.Marshal(payload)
	if err != nil {
		// 封套序列化失败理论上不可达（payload 恒为可序列化形态）；退化为
		// 最小错误封套。
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusInternalServerError)
		_, _ = w.Write([]byte(`{"ok":false,"error":"runner internal error"}`))
		return
	}
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_, _ = w.Write(body)
}

// writeStartupLine 输出启动 JSON 行（runner.js 同款形态，运维观测面）：
// ready 恒 true（入口编译期绑定），style 二选一。
func writeStartupLine(port int, e entry) {
	style := "main"
	if e.fetch != nil {
		style = "fetch"
	}
	line, _ := json.Marshal(map[string]any{
		"tw_runner": "listening",
		"port":      port,
		"ready":     true,
		"style":     style,
	})
	fmt.Println(string(line))
}

// envInt 读取整型 env（缺省/非整型回落 fallback；0 合法——TW_MAX_REQUESTS=0
// 即不限，runner.js Number() 语义对齐）。
func envInt(key string, fallback int) int {
	if v := os.Getenv(key); v != "" {
		if n, err := strconv.Atoi(v); err == nil {
			return n
		}
	}
	return fallback
}

// headerInt 读取正整型分发 header（缺省/非正数回落 fallback，node
// Number(header) + isFinite && >0 语义对齐）。
func headerInt(v string, fallback int) int {
	if n, err := strconv.Atoi(strings.TrimSpace(v)); err == nil && n > 0 {
		return n
	}
	return fallback
}
